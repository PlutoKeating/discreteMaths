{
  "name": "discretemaths",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "离散数学学习站点：每个章节子目录一个 React + Tailwind 页面，构建后由 Cloudflare Workers 以静态资源发布",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "sync:guides": "node scripts/sync-guides.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "mermaid": "^11.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.5",
    "wrangler": "^4.20.0"
  }
}
